{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcforge.dev/schemas/exceptions.schema.json",
  "title": "ArcForge structured critical-rule exceptions",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "exceptions"],
  "properties": {
    "$schema": {"const": "exceptions.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "exceptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/exception"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "approved_by", "approved_at"],
      "properties": {
        "authority": {"enum": ["human", "policy-board"]},
        "approved_by": {"$ref": "#/$defs/nonEmptyString"},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule_id",
        "scope",
        "reason",
        "owner",
        "evidence",
        "compensating_controls",
        "approval",
        "expires_at",
        "review_state"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^ARC-EXC-[0-9]{3,}$"},
        "rule_id": {"type": "string", "pattern": "^ARC-CRIT-[0-9]{3}$"},
        "scope": {"$ref": "#/$defs/nonEmptyString"},
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "owner": {"$ref": "#/$defs/nonEmptyString"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "compensating_controls": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "approval": {"$ref": "#/$defs/approval"},
        "expires_at": {"type": "string", "format": "date-time"},
        "review_state": {"enum": ["pending", "approved", "expired", "revoked"]}
      }
    }
  }
}
